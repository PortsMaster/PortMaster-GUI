## Coverage for the project code, not the vendored libraries.
[run]
source =
    PortMaster/pylibs/harbourmaster
    PortMaster/pylibs/pugwash
branch = True
## Installs and downloads run on worker threads.
concurrency = thread
## test_release_layout runs a copy of the code from a temp dir.
omit =
    */pytest-of-*/*

[report]
show_missing = False
skip_covered = False
