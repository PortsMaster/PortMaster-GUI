{
    "#info": {
        "version": 1,
        "name": "Default Theme",
        "creator": "Tekkenfede and Kloptops",
        "description": "The default PortMaster gui theme.\n\nIt supports both Light Mode and Dark Mode colour schemes.",
        "default-scheme": "Light Mode"
    },
    "#schemes": {
        "#base": {
            "#resources": {
                "click.ogg": {
                    "name": "click"
                },

                "buttons.png": {
                    "atlas": {
                        "_A": [ 0, 0, 180, 180 ],
                        "_B": [ 180, 0, 180, 180 ],
                        "_X": [ 360, 0, 180, 180 ],
                        "_Y": [ 540, 0, 180, 180 ],
                        "_START": [ 0, 180, 360, 180 ],
                        "_SELECT": [ 360, 180, 360, 180 ],
                        "_L": [ 0, 360, 270, 180 ],
                        "_R": [ 270, 360, 270, 180 ],
                        "_UNCHECKED": [ 720, 0, 180, 180 ],
                        "_CHECKED": [ 900, 0, 180, 180 ],
                        "_MORE": [ 720, 180, 180, 180 ],
                        "_LEFT": [ 900, 180, 90, 180 ],
                        "_RIGHT": [ 990, 180, 90, 180 ],
                        "_UP": [ 900, 360, 180, 90 ],
                        "_DOWN": [ 900, 450, 180, 90 ]
                    }
                },
                "no-image.jpg": {
                    "name": "NO_IMAGE"
                },

                "pointenfedde.png": {}
            }
        },
        "Light Mode": {
            "#pallet": {
                "background": [ 200, 200, 200, 255 ],
                "background_fade": [ 50, 50, 50, 85 ],
                "list_text": [ 0, 0, 0, 255 ],
                "list_selected": [ 200, 0, 0, 255 ],
                "list_unselectable": [ 128, 0, 0, 255 ],
                "button": [ 200, 200, 200, 255 ],
                "general_font": [ 0, 0, 0 ],
                "download_font": [ 0, 0, 0 ],
                "panels": [ 230, 230, 230 ],
                "selection-fill": [ 153, 204, 255 ],
                "secondary-selection-fill": [ 210, 210, 210 ]
            },
            "#resources": {
                "buttons.png": {
                    "image-mod": [ 0, 0, 0 ]
                },
                "pointenfedde.png": {
                    "image-mod": [ 0, 0, 0 ]
                }
            }
        },
        "Dark Mode": {
            "#pallet": {
                "background": [ 85, 85, 85, 255 ],
                "background_fade": [ 50, 50, 50, 85 ],
                "list_text": [ 255, 255, 255, 255 ],
                "list_selected": [ 153, 180, 255, 255 ],
                "list_unselectable": [ 255, 64, 64, 255 ],
                "button": [ 200, 200, 200, 255 ],
                "general_font": [ 200, 200, 200 ],
                "download_font": [ 0, 0, 0 ],
                "panels": [ 110, 110, 110 ],
                "selection-fill": [ 50, 80, 155 ],
                "secondary-selection-fill": [ 53, 53, 53 ]
            },
            "#resources": {
                "buttons.png": {
                    "image-mod": [ 255, 255, 255 ]
                },
                "pointenfedde.png": {
                    "image-mod": [ 255, 255, 255 ]
                }
            }
        },
        "Darker Mode": {
            "#pallet": {
                "background": [ 0, 0, 0, 255 ],
                "background_fade": [ 50, 50, 50, 0 ],
                "list_text": [ 255, 255, 255, 255 ],
                "list_selected": [ 153, 180, 255, 255 ],
                "list_unselectable": [ 200, 0, 0, 255 ],
                "button": [ 200, 200, 200, 255 ],
                "general_font": [ 200, 200, 200 ],
                "download_font": [ 255, 255, 255 ],
                "panels": [ 45, 45, 45 ],
                "selection-fill": [ 50, 80, 155 ],
                "secondary-selection-fill": [ 0, 0, 0 ]
            },
            "#resources": {
                "buttons.png": {
                    "image-mod": [ 255, 255, 255 ]
                },
                "pointenfedde.png": {
                    "image-mod": [ 255, 255, 255 ]
                }
            }
        },
        "Darkest Mode": {
            "#pallet": {
                "background": [ 0, 0, 0, 255 ],
                "background_fade": [ 50, 50, 50, 0 ],
                "list_text": [ 255, 255, 255, 255 ],
                "list_selected": [ 153, 180, 255, 255 ],
                "list_unselectable": [ 200, 0, 0, 255 ],
                "button": [ 0, 0, 0, 255 ],
                "general_font": [ 200, 200, 200 ],
                "download_font": [ 255, 255, 255 ],
                "panels": [ 0, 0, 0 ],
                "selection-fill": [ 50, 80, 155 ],
                "secondary-selection-fill": [ 0, 0, 0 ]
            },
            "#resources": {
                "buttons.png": {
                    "image-mod": [ 255, 255, 255 ]
                },
                "pointenfedde.png": {
                    "image-mod": [ 255, 255, 255 ]
                }
            }
        },
        "Dracula": {
            "#pallet": {
                "background": "#282a36",
                "background_fade": [ 50, 50, 50, 0 ],
                "list_text": "#f8f8f2",
                "list_selected": "#bd93f9",
                "list_unselectable": "#6272a4",
                "button": [ 0, 0, 0, 255 ],
                "general_font": "#f8f8f2",
                "download_font": [ 255, 255, 255 ],
                "panels": "#44475a",
                "selection-fill": "#6272a4",
                "secondary-selection-fill": [ 0, 0, 0 ]
            },
            "#resources": {
                "buttons.png": {
                    "image-mod": [ 255, 255, 255 ]
                },
                "pointenfedde.png": {
                    "image-mod": [ 255, 255, 255 ]
                }
            }
        }


    },
    "#animations": {
        "simple": {"max-frames": 10},
        "complex": {"start": 0, "max-frames": 101, "skip-frames": 5}
    },
    "#base": {
        "font": "DejaVuSans.ttf",
        "font[zh_TW]": "NotoSansTC-Regular.ttf",
        "font[zh_CN]": "NotoSansSC-Regular.ttf",
        "font[zh_HK]": "NotoSansHK-Regular.ttf",
        "font[ko_KR]": "NotoSansKR-Regular.ttf",
        "font[ja_JP]": "NotoSansJP-Regular.ttf",
        "line-height[ja_JP|zh_TW|zh_CN|zh_HK|ko_KR]": 0.8,
        "font-scale": "auto",
        "font-scale[640x480]": 1.0,
        "font-scale[480x320]": 0.85,
        "font-scale[854x480]": 0.9,
        "font-scale[960x544]": 1.0,
        "font-scale[720x480]": 1.0,
        "font-scale[720x720]": 1.45,
        "font-scale[960x720]": 1.5,
        "font-scale[1024x768]": 1.6,
        "font-scale[1280x720]": 1.5,
        "font-scale[1280x800]": 1.6,
        "font-scale[1920x1080]": 2.2,
        "font-scale[1920x1152]": 2.3
    },
    "#elements": {
        "left_pane": {
            "comment": "Left side of the screen.",
            "area": [ 0.0, 0.0, 0.3, 1.0 ],
            "area[3:2]": [ 0.0, 0.0, 0.4, 1.0 ],
            "area[wide]": [ 0.0, 0.0, 0.4, 1.0 ]
        },

        "left_pane_featured": {
            "comment": "Left side of the screen.",
            "area": [ 0.0, 0.0, 0.3, 1.0 ],
            "area[3:2]": [ 0.0, 0.0, 0.35, 1.0 ],
            "area[wide]": [ 0.0, 0.0, 0.35, 1.0 ]
        },

        "right_pane": {
            "comment": "Right side of the screen.",
            "area": [ 0.3, 0.0, 1.0, 1.0 ],
            "area[3:2]": [ 0.4, 0.0, 1.0, 1.0 ],
            "area[wide]": [ 0.4, 0.0, 1.0, 1.0 ]
        },
        "port_info_list_area": {
            "comment": "List area",
            "parent": "left_pane",
            "area": [ 0.0, 0.0, 1.0, 1.0 ]
        },
        "port_info_list_area_featured": {
            "comment": "List area",
            "parent": "left_pane_featured",
            "area": [ 0.0, 0.0, 1.0, 1.0 ]
        },

        "port_info_area": {
            "comment": "The area used for the info text/image",
            "parent": "right_pane",
            "area": [ 0.0, 0.0, 1.0, 1.0 ]
        },
        "port_info_content": {
            "comment": "The info pane above the button bar: its pieces below are stacked in it, each where the last ends, so they never overlap at any screen size.",
            "parent": "port_info_area",
            "area": [ 0.0, 0.0, 1.0, 0.92 ]
        },
        "port_info_title_area": {
            "comment": "Port Title",
            "parent": "port_info_content",
            "area": [ 0.0, 0.0, 1.0, 0.11 ]
        },
        "port_info_image_area": {
            "comment": "Port image",
            "parent": "port_info_content",
            "area": [ 0.0, 0.11, 1.0, 0.52 ]
        },

        "port_info_image_area_featured": {
            "comment": "Port image, bigger on the featured screens",
            "parent": "port_info_content",
            "area": [ 0.0, 0.11, 1.0, 0.7 ]
        },
        "port_info_desc_area_featured": {
            "comment": "The description, under it",
            "parent": "port_info_content",
            "area": [ 0.01, 0.72, 0.99, 1.0 ]
        },

        "port_info_text_area": {
            "comment": "Port Info: the rest of the pane, under the image",
            "parent": "port_info_content",
            "area": [ 0.0, 0.52, 1.0, 1.0 ]
        },
        "port_info_general_area": {
            "comment": "Genres, size and runtime: three lines",
            "parent": "port_info_text_area",
            "area": [ 0.01, 0.0, 0.99, 0.36 ]
        },
        "port_info_desc_area": {
            "comment": "The description, under them",
            "parent": "port_info_text_area",
            "area": [ 0.01, 0.38, 0.99, 1.0 ]
        },

        "featured_left_content": {
            "comment": "The featured screens' left side, above the button bar: the collection, its list and the port's details, stacked",
            "parent": "left_pane_featured",
            "area": [ 0.0, 0.0, 1.0, 0.92 ]
        },
        "featured_description_area": {
            "parent": "featured_left_content",
            "area": [ 0.02, 0.01, 0.98, 0.15 ]
        },
        "featured_image_area": {
            "parent": "featured_left_content",
            "area": [ 0.0, 0.16, 1.0, 0.33 ]
        },
        "featured_list_area": {
            "parent": "featured_left_content",
            "area": [ 0.0, 0.34, 0.95, 0.76 ]
        },
        "featured_general_area": {
            "parent": "featured_left_content",
            "area": [ 0.0, 0.78, 0.95, 1.0 ]
        },

        "background": {
            "area": [ 0.0, 0.0, 1.0, 1.0 ],
            "fill": "background",
            "border": 8,
            "font-size": 36,
            "font-color": "general_font",
            "music": "main_menu_stock.ogg",
            "music-volume": 50
        },
        "button_bar": {
            "area": [ 0.0, 0.925, 0.95, 0.99 ],
            "font-size": 16,
            "font-color": "general_font",
            "align": "midright",
            "bar": [
                "_A",
                "Accept",
                "_B",
                "Back"
            ],
            "button-sound": "click"
        },
        "option_list": {
            "area": [ 0.0, 0.21, 0.9, 0.9 ],
            "area[3:2]": [ 0.0, 0.21, 0.9, 0.8 ],
            "border": 8,
            "font-size": 30,
            "font-size[16:9]": 22,
            "font-color": "list_text",
            "select-color": "list_selected",
            "text-clip": true,
            "thickness": 10,
            "click-sound": "click",
            "click-sound-volume": 64
        }
    },
    "ports_list": {
        "#element:background": {},
